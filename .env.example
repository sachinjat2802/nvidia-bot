# NVIDIA API Configuration
# Get your API key from https://integrate.api.nvidia.com
NVIDIA_API_KEY=your-api-key-here

# NVIDIA API Base URL (OpenAI-compatible endpoint)
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Default model to use (optional)
# See available models: https://integrate.api.nvidia.com/models
DEFAULT_MODEL=nvidia/nemotron-4-340b-instruct

# Chat history limit (number of messages to keep in context)
CHAT_HISTORY_LIMIT=50