{
    "name": "nvidia-bot",
    "version": "1.0.0",
    "description": "A configurable chatbot using NVIDIA free models via API",
    "main": "dist/index.js",
    "bin": {
        "nvidia-bot": "./dist/index.js"
    },
    "scripts": {
        "build": "tsc",
        "start": "node dist/index.js",
        "dev": "ts-node src/index.ts",
        "web": "node dist/web-server.js",
        "web:dev": "ts-node src/web-server.ts",
        "lint": "eslint src --ext .ts",
        "format": "prettier --write \"src/**/*.ts\""
    },
    "keywords": [
        "nvidia",
        "chatbot",
        "ai",
        "llm"
    ],
    "author": "",
    "license": "MIT",
    "dependencies": {
        "@pinecone-database/pinecone": "^7.0.0",
        "chalk": "^4.1.2",
        "commander": "^12.1.0",
        "cors": "^2.8.5",
        "dotenv": "^16.4.5",
        "express": "^4.21.0",
        "figlet": "^1.7.0",
        "gradient-string": "^2.0.2",
        "inquirer": "^8.2.6",
        "mammoth": "^1.6.0",
        "multer": "^1.4.5-lts.1",
        "node-cron": "^4.2.1",
        "openai": "^4.73.0",
        "ora": "^5.4.1",
        "pdf-parse": "^1.1.1",
        "pg": "^8.18.0"
    },
    "devDependencies": {
        "@types/cors": "^2.8.17",
        "@types/express": "^4.17.21",
        "@types/figlet": "^1.5.8",
        "@types/inquirer": "^8.2.6",
        "@types/multer": "^1.4.11",
        "@types/node": "^20.11.0",
        "@types/node-cron": "^3.0.11",
        "@types/pdf-parse": "^1.1.4",
        "@types/pg": "^8.16.0",
        "@typescript-eslint/eslint-plugin": "^6.19.0",
        "@typescript-eslint/parser": "^6.19.0",
        "eslint": "^8.56.0",
        "prettier": "^3.2.4",
        "ts-node": "^10.9.2",
        "typescript": "^5.3.3"
    }
}
